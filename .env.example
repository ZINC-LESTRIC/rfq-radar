# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Required – your LLM provider API key (Groq or xAI)
LLM_API_KEY=your_api_key_here

# Required – model id, e.g.:
#   Groq:  llama-3.3-70b-versatile  |  llama-3.1-8b-instant  |  openai/gpt-oss-20b
#   xAI:   grok-4.1-fast  |  grok-4.7  |  grok-3-mini
LLM_MODEL=llama-3.3-70b-versatile

# Optional – override auto-detected base URL
# Groq default: https://api.groq.com/openai/v1
# xAI  default: https://api.x.ai/v1
# LLM_BASE_URL=https://api.groq.com/openai/v1
